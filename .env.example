# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration (Local or Cloud like Aiven)
# Option A: Standard separate credentials
DB_HOST=mysql-xxxx-xxxx.a.aivencloud.com # or localhost
DB_PORT=25060                           # Aiven port or 3306
DB_USER=avnadmin                        # Aiven user or root
DB_PASSWORD=your_password               # Aiven password
DB_NAME=defaultdb                       # defaultdb or arista_trinkets_db
DB_SSL=true                             # Required for Aiven MySQL
DB_CONNECTION_LIMIT=10

# Option B: Complete Service URI (e.g. from Aiven Dashboard)
# DATABASE_URL=mysql://avnadmin:password@mysql-xxxx.aivencloud.com:25060/defaultdb?ssl-mode=REQUIRED

# Security & JWT Tokens
JWT_SECRET=arista_trinkets_jwt_secret_key_2026_super_secure_key
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=arista_trinkets_refresh_secret_key_2026
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:4200,http://localhost:4201

# Email & Nodemailer Configuration
# Option 1: Gmail (recommended for quick setup)
EMAIL_SERVICE=gmail
EMAIL_USER=your@gmail.com
EMAIL_PASSWORD=your_gmail_app_password   # Use Gmail App Password, not your account password
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com
EMAIL_FROM="Arista Trinkets Concierge <your@gmail.com>"

# Option 2: Custom SMTP (uncomment and fill if not using Gmail)
# EMAIL_HOST=smtp.yourdomain.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default Admin Account (seeded automatically on first DB connection)
DEFAULT_ADMIN_EMAIL=admin@aristatrinkets.com
DEFAULT_ADMIN_PASSWORD=admin123
